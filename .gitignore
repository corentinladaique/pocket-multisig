creator.json
createKey.json
approver.json
fixture-public.json
# artefacts de build Android
*.apk
*.aab
app-release*
# keystores de signature
*.keystore

# --- divers local / hors publication ---
# retour d'expérience Gradle copié par prebuild
android/local.properties
local.properties
# journaux et captures de test
*.log
/screenshots/
# fichiers temporaires de l'éditeur
*.swp
*~
